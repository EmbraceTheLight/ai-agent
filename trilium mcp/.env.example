# 填入实际实例地址（包含 http:// 或 https://）和 ETAPI Token。
# 本机桌面实例可以使用 localhost；端口以实际实例为准。
# 这里只保留空值示例，真实配置写入被 Git 忽略的 .env。
TRILIUM_URL=
TRILIUM_TOKEN=

# CLI 和 MCP 共用的写入根；留空时 MCP 仅注册只读工具。
# 不能设为 root；读取范围仍由 ETAPI Token 决定，此设置只限制写入。
TRILIUM_WRITE_ROOT_ID=

# 可选：备份及重试记录目录。默认是所选 .env 文件旁的 .trilium-state。
# 请保留该目录；建议使用绝对路径，CLI 和 MCP 必须使用同一目录。
TRILIUM_STATE_DIR=
